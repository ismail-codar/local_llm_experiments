# Qwen3.8-27B (dense, native vision-language) - NVIDIA L40S 48 GB
#
# Hedef:
#   - Tek slot / tek aktif uzun oturum
#   - Yuksek cevap kalitesi
#   - 128K context'te rahat VRAM marji
#   - Native vision destegi
#   - CUDA + FlashAttention + TurboQuant KV
#   - Speculative decoding kapali
#
# Kaynak fork:
#   https://github.com/TheTom/llama-cpp-turboquant
#
# Target GGUF:
#   https://huggingface.co/unsloth/Qwen3.8-27B-GGUF
#
# Kullanim:
#   sh ./cli.sh --env ./qwen3.8-27b.env install
#   sh ./cli.sh --env ./qwen3.8-27b.env start
#   sh ./cli.sh --env ./qwen3.8-27b.env stop
#   sh ./cli.sh --env ./qwen3.8-27b.env log


# ---------------------------------------------------------------------------
# llama.cpp / TurboQuant
# ---------------------------------------------------------------------------

INSTALL_REPO_URL=https://github.com/TheTom/llama-cpp-turboquant.git

# feature/turboquant-kv-cache aktif gelistirme branch'i.
# Qwen3.8 ve TurboQuant icin release'e gore daha yeni CUDA/FA duzeltmelerini
# tasiyor. Production'da stabil bir build'i dogruladiktan sonra commit SHA'ya
# pinlemek, sonraki "install" islemlerinde davranisin degismesini engeller.
INSTALL_BRANCH=feature/turboquant-kv-cache

LLAMA_DIR=$ROOT_DIR/llama-cpp-turboquant


# ---------------------------------------------------------------------------
# Ag
# ---------------------------------------------------------------------------

# Uzak istemcilerden erisim gerektigi icin 0.0.0.0 birakildi.
# Sunucu sadece localhost'tan kullanilacaksa 127.0.0.1 daha guvenlidir.
HOST=0.0.0.0

# Qwen 8001, LFM 8003, MiniCPM 8004, Gemma12B 8005,
# gemma4-dflash 8006, qwen-dflash 8007, qwopus27b-mtp 8008,
# qwen3.6-27b-mtp 8009 ile cakismamasi icin.
PORT=8010

# HOST=0.0.0.0 kullanildiginda internet/LAN/VPN uzerinden ulasilabiliyorsa
# mutlaka API key veya reverse-proxy authentication kullan.
API_KEY=


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# L40S 48 GB icin UD-Q6_K_XL tercih edildi.
#
# Guncel dosya boyutlari:
#   UD-Q5_K_XL ~= 20.2 GB
#   UD-Q6_K_XL ~= 25.9 GB
#
# Onceki yorumdaki "Q5 ~= 25.9 GB" yanlisti; 25.9 GB Q6 dosyasidir.
#
# Tek slot + 128K context'te L40S'un VRAM'i Q6 icin yeterli oldugundan,
# Q5'e inerek model agirliklarinda kalite kaybetmek yerine Q6 kullanmak
# daha iyi kalite/VRAM dengesi verir.
#
# Decode hizinin maksimum olmasi kaliteden daha onemliyse Q5_K_XL
# alternatif olarak tekrar denenebilir.
MODEL_URL=https://huggingface.co/unsloth/Qwen3.8-27B-GGUF/resolve/main/Qwen3.8-27B-UD-Q6_K_XL.gguf
MODEL_FILE=$MODEL_DIR/Qwen3.8-27B-UD-Q6_K_XL.gguf


# ---------------------------------------------------------------------------
# Speculative decoding
# ---------------------------------------------------------------------------

# Secilen standart GGUF, ayri MTP-GGUF/draft model konfigurasyonu degil.
# Bu nedenle speculative decoding zorlanmiyor.
#
# Model mimarisinde MTP destegi bulunmasi tek basina yeterli degildir;
# runtime'in kullanacagi uyumlu GGUF tensorlari/draft yolu da gereklidir.
ENABLE_MTP=0
ENABLE_DFLASH=0


# ---------------------------------------------------------------------------
# Multimodal
# ---------------------------------------------------------------------------

# Qwen3.8-27B native vision-language model oldugu icin projector acik.
# L40S'ta VRAM tasarrufu icin vision'i kapatmaya gerek yok.
ENABLE_MMPROJ=1

# F16 projector olgun ve CUDA tarafinda guvenli secim.
# BF16 projector'in burada anlamli bir VRAM avantaji yok.
MMPROJ_URL=https://huggingface.co/unsloth/Qwen3.8-27B-GGUF/resolve/main/mmproj-F16.gguf
MMPROJ_FILE=$MODEL_DIR/Qwen3.8-27B-mmproj-F16.gguf


# ---------------------------------------------------------------------------
# Context
# ---------------------------------------------------------------------------

# Qwen3.8-27B'nin 64 transformer blogunun TAMAMI klasik KV cache uretmez:
#
#   64 toplam layer
#   16 full-attention layer
#   48 recurrent / Gated-DeltaNet layer
#
# Bu nedenle eski "64 layer x KV -> 128K'da ~9 GiB TurboQuant KV"
# hesabi fazla yuksekti.
#
# Asagidaki q8_0(K) + turbo4(V) konfigurasyonunda full-attention KV cache
# kabaca:
#
#   128K context -> ~3.2 GiB
#   256K context -> ~6.3 GiB
#
# Recurrent state ve CUDA workspace ayrica VRAM kullanir, ancak recurrent
# kisim klasik KV gibi token sayisiyla ayni sekilde lineer buyumez.
#
# 128K production varsayilani olarak secildi:
#   - modeli Q6 tutmaya izin verir
#   - vision/CUDA workspace icin genis marj birakir
#   - gereksiz yere 262K KV rezervasyonu yapmaz
#   - cok uzun context'teki decode bandwidth maliyetini sinirlar
CTX_SIZE=131072

# Modelin native maksimum context'i 262144'tur.
# Gercekten 128K ustu prompt gerekiyorsa L40S + Q6 + q8_0/turbo4 ile
# 262144 denenebilir; VRAM hesabi onceki konfigurasyonda sanilandan
# belirgin sekilde daha elverislidir.
#
# CTX_SIZE=262144


# ---------------------------------------------------------------------------
# Parallelism / GPU offload
# ---------------------------------------------------------------------------

# Tek aktif kullanici/oturum hedefi.
# Birden fazla slot, ayni context butcesini ve KV kapasitesini paylastirir.
PARALLEL_SLOTS=1

# 64 layer'in tamamini L40S'a offload etmek icin model layer sayisindan
# buyuk bir deger kullaniliyor.
GPU_LAYERS=99


# ---------------------------------------------------------------------------
# Batching
# ---------------------------------------------------------------------------

# 2048 / 512 llama.cpp icin guclu ve stabil bir baslangic noktasidir.
#
# BATCH_SIZE daha cok logical prompt batching'i,
# UBATCH_SIZE ise tek seferde GPU'da calisan physical micro-batch'i etkiler.
#
# L40S daha buyuk ubatch kaldirabilir; ancak 1024 her workload'da daha hizli
# degildir ve vision/uzun-prompt senaryolarinda workspace'i buyutur.
# Bu nedenle benchmark olmadan 512'den yukariya cikilmadi.
BATCH_SIZE=2048
UBATCH_SIZE=512

# cli.sh tarafinda 0 = otomatik CPU thread secimi olarak kullaniliyor.
# Ana compute GPU'da oldugu icin elle agresif thread sayisi vermeye gerek yok.
THREADS=0


# ---------------------------------------------------------------------------
# Prompt cache
# ---------------------------------------------------------------------------

# Bos birakilarak llama-server'in varsayilan prompt-cache davranisi korunur.
# Tek slotta uzun ve devam eden sohbetlerde prefix/prompt reuse yararlidir.
#
# Cache'i tamamen kapatmak icin:
# CACHE_RAM=0
CACHE_RAM=


# ---------------------------------------------------------------------------
# KV cache
# ---------------------------------------------------------------------------

# Qwen3.8 full-attention katmanlarinda:
#
#   24 query head
#    4 KV head
#   GQA ratio = 6
#
# TurboQuant fork'u yuksek GQA modellerinde K tarafinda kalite hassasiyeti
# nedeniyle zaten asymmetric KV kullanmaya yonelir ve GQA >= 6 durumunda
# Turbo K'yi q8_0'a yukseltebilir.
#
# Bunu implicit davranisa birakmak yerine acikca q8_0 seciliyor:
#
#   K = q8_0   -> attention score / retrieval kalitesini korumaya yardimci
#   V = turbo4 -> KV VRAM'ini ciddi azaltir, K kadar hassas degildir
#
# Bu profil L40S'ta turbo4/turbo4'e gore daha iyi kalite-guvenlik dengesi
# saglar ve Q6 modeli rahatca kullanmaya devam etmemizi saglar.
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=turbo4

# NOT:
# Eski TurboQuant build'lerinde CUDA FlashAttention + V=turbo4 icin bir
# stride/correctness problemi vardi. Bu problem sonraki fork degisikliklerinde
# duzeltildi. Bu env ile eski binary kullanma; branch'i guncelleyip temiz
# rebuild/install yapmak daha guvenlidir.
#
# Maksimum kalite ve TurboQuant kaynakli dequantization maliyetini olcmek
# icin ayrica su profil A/B benchmark edilebilir:
#
# CACHE_TYPE_K=q8_0
# CACHE_TYPE_V=q8_0


# ---------------------------------------------------------------------------
# Reasoning
# ---------------------------------------------------------------------------

# Qwen3.8 thinking mode varsayilan olarak acik kullaniliyor.
REASONING=on

# 4096 modelin resmi/native reasoning limiti DEGILDIR.
# Burada runaway reasoning, latency ve cikti maliyetini sinirlayan pratik
# server-side bir ust sinir olarak tutuluyor.
#
# cli.sh/request API ileride reasoning_effort destekliyorsa, reasoning
# derinligini istek bazinda yonetmek sabit global budget'tan daha esnektir.
REASONING_BUDGET=4096

# Thinking metnini ana content'ten ayirip reasoning_content alaninda
# dondurmek icin.
REASONING_FORMAT=deepseek


# ---------------------------------------------------------------------------
# Chat template
# ---------------------------------------------------------------------------

# Model GGUF icindeki resmi Qwen template'i kullanilir.
# Gereksiz custom template, thinking/tool/vision token formatinda uyumsuzluk
# cikarma riski tasir.
CHAT_TEMPLATE_FILE=


# ---------------------------------------------------------------------------
# Sampling - Qwen3.8 thinking mode
# ---------------------------------------------------------------------------

# Qwen3.8'in guncel thinking-mode onerileri:
#
#   temperature        = 1.0
#   top_k              = 20
#   top_p              = 0.95
#   min_p              = 0.0
#   repetition_penalty = 1.0
#
# Onceki Qwen nesillerindeki 0.6 temperature'i burada kullanilmiyor.
TEMP=1.0
TOP_K=20
TOP_P=0.95
MIN_P=0.0

# Bos birakmak yerine resmi/default davranisi acikca sabitliyoruz.
# Boylece llama.cpp veya cli.sh default'u ileride degisse bile model
# davranisi degismez.
REPEAT_PENALTY=1.0


# ---------------------------------------------------------------------------
# Web UI / slots
# ---------------------------------------------------------------------------

ENABLE_WEBUI=1

# Slot endpoint'leri yonetim/debug icin acik tutuluyor.
# HOST=0.0.0.0 ise bunlarin da authentication/firewall arkasinda olmasi gerekir.
ENABLE_SLOTS=1
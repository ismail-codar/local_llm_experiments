# Qwen3.8-27B (dense, native vision-language) - cli.sh ayarlari
# Kaynak fork:  https://github.com/TheTom/llama-cpp-turboquant (turboquant KV cache; MTP kapali kullaniliyor)
# Target GGUF:  https://huggingface.co/unsloth/Qwen3.8-27B-GGUF
#
# Kullanim:
#   sh ./cli.sh --env ./qwen3.8-27b.env install
#   sh ./cli.sh --env ./qwen3.8-27b.env start
#   sh ./cli.sh --env ./qwen3.8-27b.env stop
#   sh ./cli.sh --env ./qwen3.8-27b.env log
#
# Not: Bu repo "Qwen3.8-27B-GGUF" (MTP-GGUF DEGIL) -> gomulu MTP katmani yok,
# ayri bir DFlash draft modeli de yok. Bu yuzden ENABLE_MTP=0, ENABLE_DFLASH=0
# (spec decoding yok, duz decode). TurboQuant fork yine de turbo4 KV cache
# icin kullaniliyor; cli.sh MTP'siz modeli ENABLE_MTP=0 ile destekliyor.

INSTALL_REPO_URL=https://github.com/TheTom/llama-cpp-turboquant.git
INSTALL_BRANCH=feature/turboquant-kv-cache

# turboquant kurulum + calistirma dizini.
LLAMA_DIR=$ROOT_DIR/llama-cpp-turboquant

# --- Ag ---
HOST=0.0.0.0
# Qwen 8001, LFM 8003, MiniCPM 8004, Gemma12B 8005, gemma4-dflash 8006,
# qwen-dflash 8007, qwopus27b-mtp 8008, qwen3.6-27b-mtp 8009 ile cakismamak icin 8010.
PORT=8010

# Disa acik calistiriyorsan mutlaka API_KEY ver.
API_KEY=

# --- Target model (UD-Q6_K_XL ~25.9 GB; daha serin icin UD-Q5_K_XL/UD-Q4_K_XL alternatifleri de var) ---
MODEL_URL=https://huggingface.co/unsloth/Qwen3.8-27B-GGUF/resolve/main/Qwen3.8-27B-UD-Q6_K_XL.gguf
MODEL_FILE=$MODEL_DIR/Qwen3.8-27B-UD-Q6_K_XL.gguf

# --- Speculative decoding yok: repo'da MTP/DFlash varyanti yok ---
ENABLE_MTP=0
ENABLE_DFLASH=0

# --- Multimodal: native vision-language model, mmproj mevcut ---
ENABLE_MMPROJ=1
MMPROJ_URL=https://huggingface.co/unsloth/Qwen3.8-27B-GGUF/resolve/main/mmproj-F16.gguf
MMPROJ_FILE=$MODEL_DIR/Qwen3.8-27B-mmproj-F16.gguf

# --- Context / batching ---
# Model native 262144 destekliyor (1M'e genisletilebilir). Q6_K_XL (~25.9 GB,
# ~24.1 GiB) + turbo4/turbo4 KV hesabi (64 katman, 4 kv-head, head_dim 256 ->
# ~72 KiB/token): 262144 ctx -> ~18 GiB KV, toplam ~44-45 GiB. L40S nvidia-smi'de
# gercekte ~45.5 GiB gorunur (48GB nominal degil) -> tam context ~1 GiB pay
# birakir, riskli (README.md:438 de ayni sebeple Q6_K_XL icin 128K'ya inmeyi
# onerior). 131072 (128K) -> ~9 GiB KV, toplam ~35.5 GiB, rahat pay. Daha
# fazlasi icin: CACHE_TYPE_V=turbo3 (KV ~%11 daha kucuk, 262144'u ~42.5 GiB'a
# indirir) veya ENABLE_MMPROJ=0 (~0.9 GiB kazanc) ya da UD-Q5_K_XL/Q4_K_XL'e in.
CTX_SIZE=131072
PARALLEL_SLOTS=1
GPU_LAYERS=99
BATCH_SIZE=2048
UBATCH_SIZE=512
THREADS=0

# Prompt cache: bos = llama-server varsayilani. Kapatmak icin 0 ver.
CACHE_RAM=

# --- TurboQuant KV cache ---
CACHE_TYPE_K=turbo4
CACHE_TYPE_V=turbo4

# --- Reasoning ---
# Qwen3.8'de thinking mode varsayilan ACIK; istek basina kapatilabilir
# (chat_template_kwargs: {"enable_thinking": false}). deepseek formati
# dusunceyi reasoning_content'e ayirir. qwen3.6-27b-mtp.env'deki olcumler
# (REASONING_BUDGET=0) bu modelde henuz dogrulanmadi; varsayilan dengeli
# deger olarak 4096 birakildi, ayni "bos tur" belirtisi gorulurse 0'a cekilebilir.
REASONING=on
REASONING_BUDGET=4096
REASONING_FORMAT=deepseek

# --- Ozel chat template: gerek yok, gomulu Qwen template'i kullanilir ---
CHAT_TEMPLATE_FILE=

# --- Sampling (Qwen3 thinking modu onerilen degerleri) ---
TEMP=0.6
TOP_K=20
TOP_P=0.95
MIN_P=0.0
REPEAT_PENALTY=

# --- Web UI / slots / API key ---
ENABLE_WEBUI=1
ENABLE_SLOTS=1

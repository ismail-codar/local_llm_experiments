# Nex-N2-mini (Qwen3.5-35B-A3B-Base tabanli, MoE ~35B toplam / ~3B aktif) - cli.sh ayarlari
# Kaynak fork:  https://github.com/TheTom/llama-cpp-turboquant (MTP + turboquant KV cache)
# Target GGUF:  https://huggingface.co/s-batman/Nex-N2-mini-GGUF
#
# Kullanim:
#   sh ./cli.sh --env ./nex-n2-mini.env install
#   sh ./cli.sh --env ./nex-n2-mini.env start
#   sh ./cli.sh --env ./nex-n2-mini.env stop
#   sh ./cli.sh --env ./nex-n2-mini.env log
#
# Onemli notlar (repo aciklamasindan):
#   - Multimodal (vision) destekli: mmproj-Nex-N2-mini-F16.gguf ile goruntu girisi acilir.
#   - MTP YOK: kaynak surum Multi-Token Prediction agirliklarini icermez,
#     `--spec-type draft-mtp` desteklenmez. Bu yuzden ENABLE_MTP=0, ENABLE_DFLASH=0.
#   - Agentic / Adaptive Thinking: model ne zaman ve ne kadar dusunecegine kendi karar verir.

INSTALL_REPO_URL=https://github.com/TheTom/llama-cpp-turboquant.git
INSTALL_BRANCH=feature/turboquant-kv-cache

# turboquant kurulum + calistirma dizini.
LLAMA_DIR=$ROOT_DIR/llama-cpp-turboquant

# --- Ag ---
HOST=0.0.0.0
# Mevcut env'ler 8001 ve 8003-8008 portlarini kullaniyor; cakismamak icin 8009.
PORT=8009

# Disa acik calistiriyorsan mutlaka API_KEY ver.
API_KEY=

# --- Target model (Q5_K_M ~23.0 GB; Q4_K_M ~19.7 GB daha serin / Q6_K ~26.6 GB daha kaliteli) ---
MODEL_URL=https://huggingface.co/s-batman/Nex-N2-mini-GGUF/resolve/main/Nex-N2-mini-Q5_K_M.gguf
MODEL_FILE=$MODEL_DIR/Nex-N2-mini-Q5_K_M.gguf

# --- Speculative decoding: bu model MTP/draft-mtp DESTEKLEMIYOR -> kapali ---
ENABLE_MTP=0
ENABLE_DFLASH=0
SPEC_DRAFT_N_MAX=6

# --- Multimodal: vision destegi var, acik (mmproj F16 ~0.84 GB) ---
ENABLE_MMPROJ=1
MMPROJ_URL=https://huggingface.co/s-batman/Nex-N2-mini-GGUF/resolve/main/mmproj-Nex-N2-mini-F16.gguf
MMPROJ_FILE=$MODEL_DIR/mmproj-Nex-N2-mini-F16.gguf

# --- Context / batching ---
# Model max context 262144. ~23 GB model + KV cache: 48GB L40S'te 131072 guvenli
# baslangic; VRAM musaitse 262144'e cikarilabilir, sikisirsa dusurulur.
CTX_SIZE=131072
PARALLEL_SLOTS=1
GPU_LAYERS=99
BATCH_SIZE=2048
UBATCH_SIZE=512
THREADS=0

# Prompt cache: bos = llama-server varsayilani. Kapatmak icin 0 ver.
CACHE_RAM=

# --- KV cache ---
# turboquant fork'unun turbo4 tipi kullaniliyor (en yuksek KV tasarrufu).
# Not: model README'si q8_0 onerir; daha muhafazakar istersen turbo4 -> q8_0 yap.
CACHE_TYPE_K=turbo4
CACHE_TYPE_V=turbo4

# --- Reasoning: model <think> uretir -> deepseek formati ile reasoning_content'e ayrilir ---
# Adaptive thinking oldugu icin budget'i bos birakmak (model karar versin) da makul.
REASONING=on
REASONING_BUDGET=4096
REASONING_FORMAT=deepseek

# --- Ozel chat template: gerek yok, gomulu template kullanilir ---
CHAT_TEMPLATE_FILE=

# --- Sampling (repo onerilen degerleri) ---
TEMP=0.7
TOP_K=40
TOP_P=0.95
MIN_P=
REPEAT_PENALTY=

# --- Web UI / slots / API key ---
ENABLE_WEBUI=1
ENABLE_SLOTS=1

# Qwen3.6-27B (dense) + gomulu MTP speculative decoding - cli.sh ayarlari
# Kaynak fork:  https://github.com/TheTom/llama-cpp-turboquant (MTP + turboquant KV cache)
# Target GGUF:  https://huggingface.co/unsloth/Qwen3.6-27B-MTP-GGUF
#
# Kullanim:
#   sh ./cli.sh --env ./qwen3.6-27b-mtp.env install
#   sh ./cli.sh --env ./qwen3.6-27b-mtp.env start
#   sh ./cli.sh --env ./qwen3.6-27b-mtp.env stop
#   sh ./cli.sh --env ./qwen3.6-27b-mtp.env log
#
# Not: MTP (Multi-Token Prediction) modelin GGUF'una gomuludur; DFlash gibi ayri bir
# draft modeline ihtiyac yoktur. Bu yuzden ENABLE_MTP=1, ENABLE_DFLASH=0.

INSTALL_REPO_URL=https://github.com/TheTom/llama-cpp-turboquant.git
INSTALL_BRANCH=feature/turboquant-kv-cache

# turboquant kurulum + calistirma dizini.
LLAMA_DIR=$ROOT_DIR/llama-cpp-turboquant

# --- Ag ---
HOST=0.0.0.0
# Qwen 8001, LFM 8003, MiniCPM 8004, Gemma12B 8005, gemma4-dflash 8006,
# qwen-dflash 8007, qwopus27b-mtp 8008 ile cakismamak icin 8009.
PORT=8009

# Disa acik calistiriyorsan mutlaka API_KEY ver.
API_KEY=

# --- Target model (UD-Q5_K_XL; daha serin icin UD-Q4_K_XL / daha kaliteli icin UD-Q6_K_XL) ---
MODEL_URL=https://huggingface.co/unsloth/Qwen3.6-27B-MTP-GGUF/resolve/main/Qwen3.6-27B-UD-Q5_K_XL.gguf
MODEL_FILE=$MODEL_DIR/Qwen3.6-27B-UD-Q5_K_XL.gguf

# --- Gomulu MTP speculative decoding ---
ENABLE_MTP=1
ENABLE_DFLASH=0
# Her adimda MTP'den cekilecek max taslak token sayisi.
SPEC_DRAFT_N_MAX=6

# --- Multimodal: vision destegi var (gerekmiyorsa kapali birak) ---
ENABLE_MMPROJ=0
MMPROJ_URL=https://huggingface.co/unsloth/Qwen3.6-27B-MTP-GGUF/resolve/main/mmproj-F16.gguf
MMPROJ_FILE=$MODEL_DIR/Qwen3.6-27B-mmproj-F16.gguf

# --- Context / batching ---
# 27B dense + KV cache. 48GB L40S'te 131072 guvenli baslangic;
# VRAM musaitse 262144'e cikarilabilir, sikisirsa dusurulur.
CTX_SIZE=131072
# Tek slot: es zamanli istekler KUYRUKLANIR. ce-work paralel alt-ajan
# gonderdiginde ikinci ajan birincisi bitene kadar bekler ve bu ekranda
# "takildi" gibi gorunur. Paralel ajan isteniyorsa PARALLEL_SLOTS=2 --- ama
# baglam slotlar arasinda BOLUNUR (131072 -> 65536/slot), o yuzden varsayilan
# tek slot: seri ajan + tam baglam.
PARALLEL_SLOTS=1
GPU_LAYERS=99
BATCH_SIZE=2048
UBATCH_SIZE=512
THREADS=0

# Prompt cache: bos = llama-server varsayilani. Kapatmak icin 0 ver.
CACHE_RAM=

# --- TurboQuant KV cache ---
CACHE_TYPE_K=turbo4
CACHE_TYPE_V=turbo4

# --- Reasoning ---
# Qwen3.6 <think> uretir; deepseek formati onu reasoning_content'e ayirir.
#
# DUSUNME AJAN DONGUSUNDE KAPALI (REASONING_BUDGET=0). Olculmus sebep
# (2026-08-13, canli uc uzerinde, ayni payload tekrar tekrar kosuldu):
#
#   dusunme ACIK,  temp 0.7, butce  900 -> 2/4 BOS tur
#   dusunme ACIK,  temp 0.2, butce 1200 -> 3/6 BOS tur
#   dusunme KAPALI, temp 0.2            -> 0/6 bos tur, cikti 46 token (sabit)
#
# Bos tur = finish_reason stop|length, tool_calls YOK, content BOS. Iki mekanizma:
#   1) Model arac cagrisini <tool_call><function=...> biciminde DUSUNCE BLOGUNUN
#      ICINDE uretip orada bitiriyor; sunucu dusunceyi ayirinca ortada ne icerik
#      ne cagri kaliyor. Ajan harness'i bunu "is bitti" okur -> kullanici her
#      unite sonunda elle "devam et" yazmak zorunda kalir.
#   2) Kacak dusunme: 4739 karakter dusunup butceyi tuketiyor -> finish=length,
#      hic cagri yok. Butceyi 900'den 1200'e cikarmak COZMEDI.
#
# Sicaklik dusurmek arizayi kaldirmadi (0.2'de hala 3/6); kaldiran sey dusunmeyi
# kapatmak. Tek bir istekte gerekiyorsa istemci tarafindan geri acilir:
#   {"chat_template_kwargs": {"enable_thinking": true}}
#
# NOT: yukari akis llama.cpp'de --reasoning-budget yalnizca 0 (kapali) ve
# -1 (sinirsiz) kabul eder; eski 4096 degeri bu fork genisletmediyse sunucuyu
# hic baslatmayabilirdi. 0 her iki okumada da gecerlidir.
REASONING=on
REASONING_BUDGET=0
REASONING_FORMAT=deepseek

# --- Ozel chat template: gerek yok, gomulu Qwen template'i kullanilir ---
CHAT_TEMPLATE_FILE=

# --- Sampling ---
# Dusunme KAPALI oldugu icin thinking degerleri (0.6 / 0.95) gecerli degil.
# Qwen'in non-thinking onerisi 0.7 / top_p 0.8; arac cagrisinda daha da
# muhafazakar gidiliyor: 0.2'de olculen cikti 46 token'da SABIT, yani ayni
# girdi ayni cagriyi uretiyor. Kod uretim kalitesi dusuk gelirse ilk cevrilecek
# dugme TEMP'tir (0.2 -> 0.7); TOP_P 0.8 non-thinking onerisiyle birlikte kalir.
TEMP=0.2
TOP_K=20
TOP_P=0.8
MIN_P=0.0
REPEAT_PENALTY=

# --- Web UI / slots / API key ---
ENABLE_WEBUI=1
ENABLE_SLOTS=1

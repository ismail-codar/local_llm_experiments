# cloudflared yapılandırması — bu dosyayı .env olarak kopyalayıp düzenleyin.
# GERÇEK TOKEN'I BURAYA YAZMAYIN: bu dosya git'te izleniyor, .env ise ignore'lu.

# Çalışma ortamı: native (yerel süreç) | docker (cloudflare/cloudflared konteyneri)
# docker için önce: ./install.sh docker
RUNTIME=native

# Tünel modu: quick (varsayılan) | token | config | auto
#   quick  -> hesap/domain gerekmez, her başlatmada yeni *.trycloudflare.com adresi
#             (geliştirme/test içindir: ~200 eşzamanlı istek sınırı, SSE yok)
#   token  -> named tunnel, sabit adres (TUNNEL_TOKEN gerekir)
#   config -> named tunnel, yerel config.yml ile
#   auto   -> TUNNEL_TOKEN doluysa token, config.yml varsa config, yoksa quick
# Not: TUNNEL_TOKEN dolu olsa bile mod quick kaldığı sürece quick tunnel açılır;
# sabit adres istiyorsanız MODE=token (ya da auto) yapın.
MODE=quick

# Cloudflare Zero Trust > Networks > Tunnels ekranından alınan token.
# Token modunda public URL Cloudflare tarafındaki "Public Hostname" kaydıdır;
# tanımlı değilse tünel bağlanır ama erişilebilir bir adres oluşmaz.
TUNNEL_TOKEN=

# config.yml ile çalışırken opsiyonel tünel adı/UUID'si
TUNNEL_NAME=

# Quick tunnel modunda yayınlanacak yerel adres.
# Docker modunda --network host kullanılır (Linux); macOS'ta localhost yerine
# http://host.docker.internal:PORT yazın.
LOCAL_URL=http://localhost:8080

# Docker modu ayarları
DOCKER_IMAGE=cloudflare/cloudflared:latest
CONTAINER_NAME=cloudflared-tunnel
